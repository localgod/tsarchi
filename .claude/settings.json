{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/oxlint.sh",
            "timeout": 60,
            "statusMessage": "Running oxlint..."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/oxfmt.sh",
            "timeout": 60,
            "statusMessage": "Running oxfmt..."
          }
        ]
      }
    ]
  }
}
