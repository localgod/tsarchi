// See https://aka.ms/devcontainer.json for the format.
{
	"name": "tsarchi",
	// Node 24, the version npm-publish.yml builds and publishes with. Includes git and jq (used by .claude/hooks).
	"image": "mcr.microsoft.com/devcontainers/javascript-node:24",
	"features": {
		// gh is used by the .claude skills to read issues and Archi's source.
		"ghcr.io/devcontainers/features/github-cli:1": {}
	},
	// Keep Claude Code's login, settings and project memory across container rebuilds.
	"mounts": ["source=tsarchi-claude-config-${devcontainerId},target=/home/node/.claude,type=volume"],
	"containerEnv": {
		"CLAUDE_CONFIG_DIR": "/home/node/.claude"
	},
	"postCreateCommand": "sudo chown -R node:node /home/node/.claude && npm install --global @anthropic-ai/claude-code playwright && playwright install --with-deps chromium && npm ci",
	"customizations": {
		"vscode": {
			"extensions": [
				"oxc.oxc-vscode",
				"usernamehw.errorlens",
				// Provides the code-eol.* settings in .vscode/settings.json.
				"medo64.render-crlf"
			]
		}
	}
}
