{
  "name": "tsarchi",
  "version": "4.3.0",
  "description": "TypeScript implementation of the Archi model",
  "type": "module",
  "module": "./dist/src/index.mjs",
  "types": "./dist/src/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/src/index.mjs",
      "types": "./dist/src/index.d.mts"
    },
    "./node": {
      "import": "./dist/src/node/index.mjs",
      "types": "./dist/src/node/index.d.mts"
    },
    "./bundle": {
      "import": "./dist/bundle/tsarchi.mjs",
      "types": "./dist/src/index.d.mts"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist/src",
    "dist/bundle"
  ],
  "scripts": {
    "prebuild": "node scripts/generate-index.js",
    "generate:relationships": "node scripts/generate-relationships-matrix.js",
    "build": "tsc --project tsconfig.json && vp pack",
    "example": "node ./dist/examples/sample01.mjs --input sample.archimate --output out.archimate",
    "pretest": "npm run build",
    "test": "vp test",
    "compare": "node ./dist/tests/roundtrip-compare.mjs",
    "roundtrip:diff": "npm run build --silent && node ./dist/tests/roundtrip-diff.mjs",
    "dev": "tsc --watch",
    "lint": "vp lint --ignore-path .gitignore .",
    "lintfix": "vp lint --fix --ignore-path .gitignore .",
    "format": "vp fmt --check src tests scripts examples vite.config.ts README.md LICENSE.md CHANGELOG.md CONTRIBUTING.md",
    "formatfix": "vp fmt src tests scripts examples vite.config.ts README.md LICENSE.md CHANGELOG.md CONTRIBUTING.md",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/localgod/tsarchi"
  },
  "keywords": [
    "typescript",
    "architecture",
    "visualization"
  ],
  "author": "Johannes Skov Frandsen",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/localgod/tsarchi/issues"
  },
  "homepage": "https://github.com/localgod/tsarchi",
  "devDependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^26.0.0",
    "chalk": "^6.0.0",
    "quickjs-emscripten-core": "^0.32.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.3"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
  }
}
