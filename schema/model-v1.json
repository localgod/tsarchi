{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/localgod/tsarchi/main/schema/model-v1.json",
  "title": "tsarchi model",
  "description": "An Archi model in tsarchi's lossless JSON format, version 1. Concepts are in flat lists sorted by id; each folder lists its members in file order; diagram children and connections are in file order.",
  "type": "object",
  "required": [
    "formatVersion",
    "model",
    "folders",
    "elements",
    "relationships",
    "views"
