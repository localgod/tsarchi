{
  "formatVersion": 1,
  "model": {
    "id": "id-c2c-model",
    "name": "connection to connection",
    "version": "5.0.0"
  },
  "folders": [
    {
      "id": "id-c2c-strategy",
      "type": "strategy",
      "name": "Strategy"
    },
    {
      "id": "id-c2c-business",
      "type": "business",
      "name": "Business",
      "members": [
        "id-clerk",
        "id-cashier",
        "id-contract"
      ]
    },
    {
      "id": "id-c2c-application",
      "type": "application",
      "name": "Application"
    },
    {
      "id": "id-c2c-technology",
      "type": "technology",
      "name": "Technology & Physical"
    },
    {
      "id": "id-c2c-motivation",
      "type": "motivation",
      "name": "Motivation"
    },
    {
      "id": "id-c2c-implementation",
      "type": "implementation_migration",
      "name": "Implementation & Migration"
    },
    {
      "id": "id-c2c-other",
      "type": "other",
      "name": "Other"
    },
    {
      "id": "id-c2c-relations",
      "type": "relations",
      "name": "Relations",
      "members": [
        "id-assignment",
        "id-contract-association",
        "id-assignment-association"
      ]
    },
    {
      "id": "id-c2c-views",
      "type": "diagrams",
      "name": "Views",
      "members": [
        "id-c2c-view"
      ]
    }
  ],
  "elements": [
    {
      "id": "id-cashier",
      "type": "BusinessRole",
      "name": "Cashier"
    },
    {
      "id": "id-clerk",
      "type": "BusinessActor",
      "name": "Clerk"
    },
    {
      "id": "id-contract",
      "type": "BusinessObject",
      "name": "Contract"
    }
  ],
  "relationships": [
    {
      "id": "id-assignment",
      "type": "AssignmentRelationship",
      "name": "assigned",
      "source": "id-clerk",
      "target": "id-cashier"
    },
    {
      "id": "id-assignment-association",
      "type": "AssociationRelationship",
      "name": "to contract",
      "source": "id-assignment",
      "target": "id-contract"
    },
    {
      "id": "id-contract-association",
      "type": "AssociationRelationship",
      "name": "from contract",
      "source": "id-contract",
      "target": "id-assignment"
    }
  ],
  "views": [
    {
      "id": "id-c2c-view",
      "type": "ArchimateDiagramModel",
      "name": "Connection View",
      "children": [
        {
          "id": "id-clerk-object",
          "type": "DiagramObject",
          "archimateElement": "id-clerk",
          "bounds": {
            "x": 40,
            "y": 40,
            "width": 120,
            "height": 55
          }
        },
        {
          "id": "id-cashier-object",
          "type": "DiagramObject",
          "archimateElement": "id-cashier",
          "bounds": {
            "x": 280,
            "y": 40,
            "width": 120,
            "height": 55
          },
          "targetConnections": [
            "id-assignment-connection"
          ]
        },
        {
          "id": "id-contract-object",
          "type": "DiagramObject",
          "archimateElement": "id-contract",
          "bounds": {
            "x": 160,
            "y": 160,
            "width": 120,
            "height": 55
          },
          "targetConnections": [
            "id-assignment-association-connection"
          ]
        }
      ],
      "connections": [
        {
          "id": "id-assignment-connection",
          "type": "Connection",
          "source": "id-clerk-object",
          "target": "id-cashier-object",
          "archimateRelationship": "id-assignment",
          "targetConnections": [
            "id-contract-connection"
          ],
          "bendpoints": [
            {
              "startX": 10,
              "startY": 20,
              "endX": -10,
              "endY": 20
            }
          ]
        },
        {
          "id": "id-assignment-association-connection",
          "type": "Connection",
          "source": "id-assignment-connection",
          "target": "id-contract-object",
          "archimateRelationship": "id-assignment-association"
        },
        {
          "id": "id-contract-connection",
          "type": "Connection",
          "source": "id-contract-object",
          "target": "id-assignment-connection",
          "archimateRelationship": "id-contract-association"
        }
      ]
    }
  ],
  "extensions": {
    "xmlDeclaration": [
      {
        "name": "version",
        "value": "1.0"
      },
      {
        "name": "encoding",
        "value": "UTF-8"
      }
    ],
    "namespaces": [
      {
        "prefix": "xsi",
        "uri": "http://www.w3.org/2001/XMLSchema-instance"
      },
      {
        "prefix": "archimate",
        "uri": "http://www.archimatetool.com/archimate"
      }
    ]
  }
}
