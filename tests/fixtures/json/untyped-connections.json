{
  "formatVersion": 1,
  "model": {
    "id": "id-untyped-model",
    "name": "untyped connections",
    "version": "5.0.0"
  },
  "folders": [
    {
      "id": "id-untyped-strategy",
      "type": "strategy",
      "name": "Strategy"
    },
    {
      "id": "id-untyped-business",
      "type": "business",
      "name": "Business"
    },
    {
      "id": "id-untyped-application",
      "type": "application",
      "name": "Application",
      "members": [
        "id-gateway",
        "id-orders",
        "id-billing"
      ]
    },
    {
      "id": "id-untyped-technology",
      "type": "technology",
      "name": "Technology & Physical"
    },
    {
      "id": "id-untyped-motivation",
      "type": "motivation",
      "name": "Motivation"
    },
    {
      "id": "id-untyped-implementation",
      "type": "implementation_migration",
      "name": "Implementation & Migration"
    },
    {
      "id": "id-untyped-other",
      "type": "other",
      "name": "Other"
    },
    {
      "id": "id-untyped-relations",
      "type": "relations",
      "name": "Relations",
      "members": [
        "id-gateway-orders",
        "id-gateway-billing"
      ]
    },
    {
      "id": "id-untyped-views",
      "type": "diagrams",
      "name": "Views",
      "members": [
        "id-gateway-view"
      ]
    }
  ],
  "elements": [
    {
      "id": "id-billing",
      "type": "ApplicationComponent",
      "name": "Billing"
    },
    {
      "id": "id-gateway",
      "type": "ApplicationComponent",
      "name": "Gateway"
    },
    {
      "id": "id-orders",
      "type": "ApplicationComponent",
      "name": "Orders"
    }
  ],
  "relationships": [
    {
      "id": "id-gateway-billing",
      "type": "FlowRelationship",
      "name": "billing",
      "source": "id-gateway",
      "target": "id-billing"
    },
    {
      "id": "id-gateway-orders",
      "type": "FlowRelationship",
      "name": "orders",
      "source": "id-gateway",
      "target": "id-orders"
    }
  ],
  "views": [
    {
      "id": "id-gateway-view",
      "type": "ArchimateDiagramModel",
      "name": "Gateway View",
      "children": [
        {
          "id": "id-gateway-object",
          "type": "DiagramObject",
          "archimateElement": "id-gateway",
          "bounds": {
            "x": 40,
            "y": 40,
            "width": 120,
            "height": 55
          }
        },
        {
          "id": "id-orders-object",
          "type": "DiagramObject",
          "archimateElement": "id-orders",
          "bounds": {
            "x": 280,
            "y": 40,
            "width": 120,
            "height": 55
          },
          "targetConnections": [
            "id-orders-connection"
          ]
        },
        {
          "id": "id-billing-object",
          "type": "DiagramObject",
          "archimateElement": "id-billing",
          "bounds": {
            "x": 280,
            "y": 160,
            "width": 120,
            "height": 55
          },
          "targetConnections": [
            "id-billing-connection",
            "id-note-connection"
          ]
        },
        {
          "id": "id-untyped-note",
          "type": "Note",
          "name": "Billing is batched nightly",
          "bounds": {
            "x": 40,
            "y": 160,
            "width": 160,
            "height": 55
          }
        }
      ],
      "connections": [
        {
          "id": "id-orders-connection",
          "type": "Connection",
          "source": "id-gateway-object",
          "target": "id-orders-object",
          "archimateRelationship": "id-gateway-orders"
        },
        {
          "id": "id-billing-connection",
          "type": "Connection",
          "source": "id-gateway-object",
          "target": "id-billing-object",
          "archimateRelationship": "id-gateway-billing"
        },
        {
          "id": "id-note-connection",
          "type": "Connection",
          "implicitType": true,
          "source": "id-untyped-note",
          "target": "id-billing-object"
        }
      ]
    }
  ],
  "extensions": {
    "xmlDeclaration": [
      {
        "name": "version",
        "value": "1.0"
      },
      {
        "name": "encoding",
        "value": "UTF-8"
      }
    ],
    "namespaces": [
      {
        "prefix": "xsi",
        "uri": "http://www.w3.org/2001/XMLSchema-instance"
      },
      {
        "prefix": "archimate",
        "uri": "http://www.archimatetool.com/archimate"
      }
    ]
  }
}
