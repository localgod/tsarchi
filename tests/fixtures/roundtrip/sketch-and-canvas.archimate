<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" xmlns:canvas="http://www.archimatetool.com/archimate/canvas" name="sketch and canvas" id="id-sketch-canvas-model" version="5.0.0">
  <folder name="Strategy" id="id-sc-strategy" type="strategy"/>
  <folder name="Business" id="id-sc-business" type="business"/>
  <folder name="Application" id="id-sc-application" type="application"/>
  <folder name="Technology &amp; Physical" id="id-sc-technology" type="technology"/>
  <folder name="Motivation" id="id-sc-motivation" type="motivation"/>
  <folder name="Implementation &amp; Migration" id="id-sc-implementation" type="implementation_migration"/>
  <folder name="Other" id="id-sc-other" type="other"/>
  <folder name="Relations" id="id-sc-relations" type="relations"/>
  <folder name="Views" id="id-sc-views" type="diagrams">
    <element xsi:type="archimate:SketchModel" name="Sketch" id="id-sketch" background="1">
      <child xsi:type="archimate:Group" id="id-sketch-group" name="Group" textAlignment="1">
        <bounds x="36" y="60" width="400" height="140"/>
        <sourceConnection id="id-sketch-connection" name="talks to" source="id-sketch-group" target="id-sketch-actor" type="3" lineColor="#ff0000" lineWidth="2" font="1|Segoe UI|9.0|1|WINDOWS|1|-12|0|0|0|700|0|0|0|0|3|2|1|34|Segoe UI" fontColor="#0000ff" textPosition="0">
          <bendpoint startX="10" endY="-20"/>
          <bendpoint startX="30" startY="5" endX="-40" endY="15"/>
          <documentation>Sketch connection</documentation>
          <property key="weight" value="heavy"/>
        </sourceConnection>
        <child xsi:type="archimate:SketchModelSticky" id="id-sticky-nested" name="Sticky" lineColor="#5c5c5c" textAlignment="1" textPosition="1" fillColor="#ffffb5" alpha="200" fontColor="#333333">
          <bounds x="49" y="48" width="135" height="70"/>
          <content>Sticky content</content>
          <documentation>Sticky documentation</documentation>
          <property key="status" value="draft"/>
          <feature name="lineAlpha" value="128"/>
        </child>
      </child>
      <child xsi:type="archimate:SketchModelActor" id="id-sketch-actor" name="Actor" targetConnections="id-sketch-connection" lineColor="#000000" textPosition="2">
        <bounds x="624" y="109" width="75" height="100"/>
        <documentation>An actor</documentation>
      </child>
      <child xsi:type="archimate:SketchModelSticky" id="id-sticky" name="Sticky" lineColor="#5c5c5c" textAlignment="1" fillColor="#60ff60">
        <bounds x="305" y="313" width="135" height="70"/>
      </child>
      <documentation>A sketch view</documentation>
      <property key="owner" value="architecture"/>
    </element>
    <element xsi:type="canvas:CanvasModel" name="Canvas" id="id-canvas" connectionRouterType="2">
      <child xsi:type="canvas:CanvasModelBlock" id="id-block" textAlignment="1" textPosition="1" borderColor="#000000" lineColor="#111111" locked="true" imagePath="images/block.png" imagePosition="2" hintTitle="Block hint">
        <bounds x="88" y="43" width="200" height="200"/>
        <sourceConnection xsi:type="canvas:CanvasModelConnection" id="id-canvas-connection" source="id-block" target="id-canvas-sticky" type="1" locked="true"/>
        <child xsi:type="canvas:CanvasModelSticky" id="id-nested-sticky" fillColor="#ffff95" borderColor="#C0C0C0" textPosition="1">
          <bounds x="10" y="10" width="75" height="63"/>
        </child>
        <content>Block</content>
        <hintContent>Fill in the block</hintContent>
        <property key="section" value="1"/>
      </child>
      <child xsi:type="canvas:CanvasModelImage" id="id-image" borderColor="#000000" locked="true" imagePath="images/logo.png">
        <bounds x="395" y="51" width="200" height="150"/>
      </child>
      <child xsi:type="canvas:CanvasModelSticky" id="id-canvas-sticky" targetConnections="id-canvas-connection" fillColor="#ffa093" borderColor="#C0C0C0" textPosition="1" imagePath="images/sticky.png" imagePosition="0">
        <bounds x="756" y="217" width="75" height="63"/>
        <content>Sticky</content>
        <notes>Remember this</notes>
      </child>
    </element>
  </folder>
</archimate:model>
